PORT=3001
NODE_ENV=development
JWT_SECRET=troque-esta-chave-por-uma-longa-e-aleatoria
JWT_EXPIRES=8h
# 1 = produção SEFAZ | 2 = homologação
AMBIENTE_PADRAO=2
CORS_ORIGIN=http://localhost:3001
DATA_DIR=./data

# --- Emissão fiscal ---
# local = simulado, sem valor fiscal (padrão) | focus = transmissão real via Focus NFe
FISCAL_PROVIDER=local
# Token da empresa no painel Focus (homologação e produção têm tokens diferentes)
FOCUS_TOKEN=
# homologacao (sem valor fiscal) | producao (notas válidas — cuidado)
FOCUS_AMBIENTE=homologacao
# Intervalo de consulta dos documentos "processando", em ms
FOCUS_POLL_MS=15000

# --- CIOT ---
# local = registro interno | antt = Web Service PEF da ANTT (mTLS com certificado A1)
CIOT_PROVIDER=local
ANTT_AMBIENTE=homologacao
ANTT_PFX_PATH=
ANTT_PFX_SENHA=
