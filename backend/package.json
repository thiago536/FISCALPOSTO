    "test:antt": "node tests/antt-payload.test.js",
    "test:antt-mtls": "node tests/antt-mtls.test.js",
    "test:seguranca": "node tests/seguranca-producao.test.js",
    "test:focus": "node tests/e2e-focus.js",
    "test:frontend": "node tests/frontend-ciot.test.js",
